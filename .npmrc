# React Native 0.87 (rc.1 onwards, still present in GA) trips a spurious npm ERESOLVE in the
# @react-native/eslint-config peer chain: it reports `Found: prettier@undefined` even though the
# root project's prettier ^3.6.2 (resolving to 3.8.1) plainly satisfies the config's `prettier >=2`
# peer. Reproduces on npm 10.9.8 from a clean tree with no lockfile. Install with legacy peer deps
# until npm resolves it upstream.
legacy-peer-deps=true
