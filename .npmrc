# React Native 0.87.0-rc.1+ trips a spurious npm ERESOLVE in the @react-native/eslint-config
# peer chain (its prettier ">=2" peer is actually satisfied by prettier ^3.6.2; @react-native/
# eslint-plugin bumped version but has no deps/peers). npm 10 refuses to auto-override it the way
# it does on rc.0. Install with legacy peer deps until RN 0.87 stabilizes.
legacy-peer-deps=true
