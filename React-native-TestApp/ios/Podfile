# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, '17.0'
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'ReactNativeTesApp' do
  config = use_native_modules!
  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/..",
    :fabric_enabled => true,
    :hermes_enabled => true
  )




  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
    
    # Fix for C++20 compilation issues with Xcode 26+
    # Affects pods like fmt, Yoga, and other C++ libraries
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        # Special handling for fmt pod - downgrade to C++17 to avoid consteval issues
        # fmt 11.0.2 has consteval compatibility issues with Xcode 26.6's strict C++20
        if target.name == 'fmt'
          config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++17'
          config.build_settings['GCC_TREAT_WARNINGS_AS_ERRORS'] = 'NO'
        end
        
        # Check if this is a C++ target using C++20
        if config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] == 'c++20' || 
           config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] == 'gnu++20'
          config.build_settings['GCC_WARN_ABOUT_INVALID_OFFSETOF_MACRO'] = 'NO'
          # Remove -Werror to prevent warnings from failing the build
          config.build_settings['GCC_TREAT_WARNINGS_AS_ERRORS'] = 'NO'
          
          # Remove -Werror and -Wall from WARNING_CFLAGS to prevent build failures
          # This is the source of the -Werror flag in the compilation command
          warning_flags = config.build_settings['WARNING_CFLAGS'] || ['$(inherited)']
          if warning_flags.is_a?(String)
            warning_flags = warning_flags.split(' ')
          end
          warning_flags.delete('-Werror')
          warning_flags.delete('-Wall')
          config.build_settings['WARNING_CFLAGS'] = warning_flags.join(' ')
          
          # Also modify OTHER_CFLAGS and OTHER_CPLUSPLUSFLAGS as fallback
          ['OTHER_CFLAGS', 'OTHER_CPLUSPLUSFLAGS'].each do |setting|
            flags = config.build_settings[setting] || '$(inherited)'
            if flags.is_a?(String)
              flags = flags.gsub(/-Werror\b/, '').gsub(/-Wall\b/, '').strip
              flags += ' -Wno-error' unless flags.include?('-Wno-error')
            elsif flags.is_a?(Array)
              flags.delete('-Werror')
              flags.delete('-Wall')
              flags << '-Wno-error' unless flags.include?('-Wno-error')
            end
            config.build_settings[setting] = flags
          end
        end
      end
    end
  end
end
